# Frontend-safe values only. NEVER put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# true  = run on built-in dummy data (no Supabase, no Teammate 1 routes needed)
# false = talk to the real Supabase project and /api routes
NEXT_PUBLIC_USE_DUMMY=true
